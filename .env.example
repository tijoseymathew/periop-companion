# PeriOp Companion — environment template.
# Copy to .env and fill in. Everything here is optional: with no key the app
# runs the keyless STUB demo (synthetic cases, instant stage runs).

# --- Live NIM generation ---------------------------------------------------
# Your personal NVIDIA NIM API key. Create one (free) at https://build.nvidia.com
# (top-right "Get API Key") — it looks like `nvapi-...`. With this set, the
# reasoning/fast tiers call hosted NIMs on build.nvidia.com. No GPU needed.
# NGC_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Force the keyless demo even if a key is present (1), or force live (0).
# Leave unset to auto-select: live when a key is present, stub otherwise.
# PERIOP_STUB_RUNNER=1

# --- Optional: override model tiers / endpoints ----------------------------
# Defaults target build.nvidia.com. Point these at self-hosted NIMs to run the
# full speech + reasoning pipeline locally (see docs/selfhosted.md).
# PERIOP_REASONING_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# PERIOP_FAST_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
# PERIOP_REASONING_BASE_URL=https://integrate.api.nvidia.com/v1
# PERIOP_FAST_BASE_URL=https://integrate.api.nvidia.com/v1
# PERIOP_ASR_GRPC_URL=localhost:50051          # Parakeet ASR (self-hosted only)
# PERIOP_TTS_BASE_URL=http://localhost:9001    # Magpie TTS (self-hosted only)

# --- Optional: server bind (containers set these to 0.0.0.0:7860) ----------
# PERIOP_API_HOST=127.0.0.1
# PERIOP_API_PORT=8000

# --- Optional: Langfuse tracing (all three required to export) -------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
