{
  "notes": [
    {
      "t": "08:00",
      "text": "induction propofol two hundred and fifty milligrams"
    },
    {
      "t": "08:02",
      "text": "LMA sixteen in place, good seal, capnograph trace confirmed"
    },
    {
      "t": "08:05",
      "text": "fentanyl twenty micrograms intravenous"
    },
    {
      "t": "08:10",
      "text": "rocuronium fifty milligrams intravenous"
    },
    {
      "t": "08:15",
      "text": "normal saline one liter fluid bolus administered"
    },
    {
      "t": "08:30",
      "text": "mean arterial pressure dropped to fifty five mmHg, atropine one milligram intravenous given"
    },
    {
      "t": "08:45",
      "text": "desflurane at one point two percent for maintenance"
    },
    {
      "t": "09:00",
      "text": "surgery completed, LMA removed, patient extubated smoothly"
    }
  ],
