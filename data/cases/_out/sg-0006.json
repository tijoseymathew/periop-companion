    {
      "source_id": "audio:postop-interview",
      "type": "audio",
      "chunks": [],
      "segments": [
        {
          "seg_id": "s001",
          "t0": 0.0,
          "t1": 3.2,
          "speaker": "PROVIDER",
          "text": "Morning, how are you feeling after the surgery?"
        },
        {
          "seg_id": "s002",
          "t0": 3.6,
          "t1": 7.2,
          "speaker": "PATIENT",
          "text": "Got some pain here, but not too bad lah."
        },
        {
          "seg_id": "s003",
          "t0": 7.6,
          "t1": 12.0,
          "speaker": "PROVIDER",
          "text": "On a scale of 0 to 10, what’s your pain level?"
        },
        {
          "seg_id": "s004",
          "t0": 12.4,
          "t1": 16.0,
          "speaker": "PATIENT",
          "text": "Maybe 5? It’s there, but I can bear it."
        },
        {
          "seg_id": "s005",
          "t0": 16.4,
          "t1": 19.2,
          "speaker": "PROVIDER",
          "text": "Any nausea or feeling like you’ll vomit?"
        },
        {
          "seg_id": "s006",
          "t0": 19.6,
          "t1": 23.2,
          "speaker": "PATIENT",
          "text": "Stomach’s a bit upset, but no throwing up yet."
        },
        {
          "seg_id": "s007",
          "t0": 23.6,
          "t1": 26.8,
          "speaker": "PROVIDER",
          "text": "Airway okay? Any sore throat or breathing trouble?"
        },
        {
          "seg_id": "s008",
          "t0": 27.2,
          "t1": 30.0,
          "speaker": "PATIENT",
          "text": "Throat sore a little, but breathing’s fine."
        },
        {
          "seg_id": "s009",
          "t0": 30.4,
          "t1": 32.4,
          "speaker": "PROVIDER",
          "text": "Remember anything from the OR?"
        },
        {
          "seg_id": "s010",
          "t0": 32.8,
          "t1": 35.6,
          "speaker": "PATIENT",
          "text": "Nope, everything’s blank. Woke up here only."
        },
        {
          "seg_id": "s011",
          "t0": 36.0,
          "t1": 39.6,
          "speaker": "PROVIDER",
          "text": "We’re watching your BP and sugar levels. Any worries?"
        },
        {
          "seg_id": "s012",
          "t0": 40.0,
          "t1": 43.2,
          "speaker": "PATIENT",
          "text": "BP’s been okay, sugar’s stable. Thanks for checking."
        }
      ]
    }
