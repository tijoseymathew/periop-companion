  "preop_note_claims": [
    "History includes hypertension, hyperlipidemia, type 2 diabetes mellitus, and osteoarthritis of the knees.",
    "Current medications: Amlodipine 5mg daily, Lisinopril 10mg daily, Atorvastatin 20mg nightly, Metformin 500mg twice daily, Paracetamol 500mg as needed.",
    "Discontinued medication: Aspirin 75mg daily (stopped preoperatively).",
    "Allergy to penicillin with symptoms of rash and urticaria.",
    "ASA Physical Status II due to controlled hypertension, hyperlipidemia, type 2 diabetes mellitus, and osteoarthritis.",
    "Airway assessment: normal Mallampati score, adequate thyromental distance, no anticipated airway difficulties.",
    "Anesthesia plan: spinal anesthesia with bupivacaine and fentanyl, with intraoperative IV paracetamol 1g for analgesia and ondansetron 4mg for PONV prophylaxis."
  ],
  "handoff_claims": [
    "Patient has a history of hypertension, hyperlipidemia, type 2 diabetes mellitus, osteoarthritis, and a penicillin allergy with rash and urticaria.",
    "Intraoperative management included spinal anesthesia with bupivacaine and fentanyl, with intraoperative administration of IV paracetamol 1g and ondansetron 4mg.",
    "Anticipated postoperative issues include potential hypotension from spinal anesthesia, need for continued postoperative pain management, and monitoring for postoperative nausea and vomiting despite prophylaxis."
  ],
  "distractors": [
    "Pneumonia resolved in 2014",
    "Left wrist fracture in 2005",
    "Hyperthyroidism treated in 2010"
  ]
