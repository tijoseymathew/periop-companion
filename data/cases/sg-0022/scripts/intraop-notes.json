{
  "notes": [
    {
      "t": "08:00",
      "text": "Spinal anesthesia administered with bupivacaine twenty-five milligrams and fentanyl twenty-five micrograms"
    },
    {
      "t": "08:05",
      "text": "Eighteen-gauge IV line placed in left antecubital fossa"
    },
    {
      "t": "08:10",
      "text": "Airway management: spontaneous breathing, SpO2 ninety-eight percent"
    },
    {
      "t": "08:15",
      "text": "Administered IV paracetamol one gram and ondansetron four milligrams"
    },
    {
      "t": "08:30",
      "text": "Hypotension noted, mean arterial pressure sixty-five mmHg, treated with five hundred ml fluid bolus and ten mg phenylephrine IV"
    },
    {
      "t": "08:45",
      "text": "Surgery completed, patient stable, no residual block"
    }
  ],
