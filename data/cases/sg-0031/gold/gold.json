  "preop_note_claims": [
    "Patient has atrial fibrillation on apixaban, ischaemic heart disease with prior PCI and stent (2021), and CKD stage 3.",
    "Current medications: apixaban 5mg twice daily, bisoprolol 2.5mg once daily, atorvastatin 40mg once daily; furosemide 20mg once daily discontinued about 6 months ago.",
    "Allergy to penicillin (rash).",
    "Last apixaban dose was taken the morning before surgery (~14 hours prior), not 3 days prior as originally charted.",
    "ASA Physical Status III given cardiac, renal, and anticoagulation risk factors.",
    "Anaesthesia plan: spinal anaesthesia with sedation, with a general-anaesthesia back-up plan given the recent anticoagulant dose."
  ],
  "handoff_claims": [
    "Patient underwent hemiarthroplasty for a displaced left neck-of-femur fracture; spinal anaesthesia converted intra-operatively to general anaesthesia with endotracheal intubation after an inadequate block.",
    "Intra-operative course included a hypotensive episode (BP 70/40) treated with phenylephrine, and a 500 mL estimated blood loss requiring 1 unit packed red cells.",
    "Anticipated postoperative issues: monitor blood pressure and renal function given CKD stage 3 and recent apixaban dosing, and manage anticoagulation restart timing with the surgical team."
  ],
