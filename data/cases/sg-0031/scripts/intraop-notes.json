{
  "notes": [
    {
      "t": "09:00",
      "text": "spinal anaesthesia performed at L3 L4 level, clear CSF on first attempt"
    },
    {
      "t": "09:01",
      "text": "hyperbaric bupivacaine twelve point five milligrams intrathecal with fentanyl twenty five micrograms"
    },
    {
      "t": "09:03",
      "text": "sedation started, midazolam one milligram"
    },
    {
      "t": "09:05",
      "text": "block level checked, T10 sensory level achieved, patient comfortable"
    },
    {
      "t": "09:20",
      "text": "block patchy on the surgical side, patient reporting sharp discomfort at the incision"
    },
    {
      "t": "09:22",
      "text": "topping up sedation, propofol infusion started at fifty micrograms per kilogram per minute"
    },
    {
      "t": "09:25",
      "text": "patient still uncomfortable despite top up, converting to general anaesthesia"
    },
    {
      "t": "09:26",
      "text": "induction propofol one hundred milligrams, fentanyl fifty micrograms"
    },
    {
      "t": "09:27",
      "text": "rocuronium fifty milligrams for muscle relaxation"
    },
    {
      "t": "09:28",
      "text": "size seven endotracheal tube placed, grade one view, tube secured"
    },
    {
      "t": "09:45",
      "text": "blood pressure down to seventy over forty, giving phenylephrine one hundred micrograms"
    },
    {
      "t": "09:47",
      "text": "estimated blood loss now four hundred milliliters, second eighteen gauge line placed in the right hand"
    },
    {
      "t": "09:50",
      "text": "starting one unit packed red cells for the blood loss"
    },
    {
      "t": "09:58",
      "text": "blood pressure recovering to one hundred five over sixty five after the transfusion"
    },
    {
      "t": "10:20",
      "text": "surgery closing, reversal neostigmine two point five milligrams with glycopyrrolate point four milligrams"
    },
    {
      "t": "10:23",
      "text": "extubated, breathing spontaneously, oxygen saturation ninety eight percent on room air"
    },
    {
      "t": "10:25",
      "text": "total estimated blood loss five hundred milliliters, one unit packed cells given, patient stable for recovery"
    }
  ],
