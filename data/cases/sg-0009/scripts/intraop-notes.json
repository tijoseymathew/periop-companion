{
  "notes": [
    {
      "t": "08:00",
      "text": "induction propofol one hundred twenty milligrams"
    },
    {
      "t": "08:02",
      "text": "LMA size four in place, secure airway"
    },
    {
      "t": "08:05",
      "text": "fentanyl twenty micrograms IV for analgesia"
    },
    {
      "t": "08:10",
      "text": "vecuronium fifty milligrams IV for muscle relaxation"
    },
    {
      "t": "08:20",
      "text": "normal saline one liter IV fluid running at one hundred fifty mL per hour"
    },
    {
      "t": "09:00",
      "text": "hypotension noted, mean arterial pressure forty five mmHg, atropine one milligram IV administered"
    },
    {
      "t": "09:15",
      "text": "surgery completed, emergence started with neostigmine two milligrams and sugammadex one hundred sixty milligrams IV"
    }
  ],
