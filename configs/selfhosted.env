# Self-hosted NIM endpoints (spec §8). Adjust host to your GPU box.
# Usage:  set -a; source configs/selfhosted.env; set +a
#
# Reference deployment: DGX Spark at 192.168.68.105 running
#   :8000  llama-3.3-nemotron-super-49b-v1.5   (reasoning, OpenAI-compatible)
#   :8001  nvidia-nemotron-nano-9b-v2          (fast, OpenAI-compatible)
#   :9000  parakeet-1-1b-ctc-en-us             (ASR, HTTP; gRPC :50051)
#   :9001  magpie-tts-multilingual             (TTS, HTTP; gRPC :50052)
# No API key is needed for local endpoints.

PERIOP_REASONING_BASE_URL=http://192.168.68.105:8000/v1
PERIOP_FAST_BASE_URL=http://192.168.68.105:8001/v1
PERIOP_ASR_BASE_URL=http://192.168.68.105:9000
PERIOP_ASR_GRPC_URL=192.168.68.105:50051
PERIOP_TTS_BASE_URL=http://192.168.68.105:9001
