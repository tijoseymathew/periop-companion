.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
# TTS-rendered audio is large (~8.5 MB/case); regenerate with
# scripts/render_audio.py — the *.segments.json gold manifests are committed
data/cases/*/audio/*.wav
# raw profiler traces carry full prompt/response text; commit the distilled
# reports in evals/profile/ instead
evals/profile/all_requests_profiler_traces.json
evals/profile/workflow_output.json
# .claude/ is local session state (incl. the .claude/skills symlinks used for
# in-clone discovery) — never committed.
.claude/
# .agents/skills/ holds committed agent skills. Re-include them past any
# user-global ".agents/*" ignore; keep warren (machine-local Telegram wiring) out.
!.agents/
!.agents/**
.agents/skills/warren/
skills-lock.json
# mkdocs build output
site/

# UI build outputs
node_modules/
ui/node_modules/
ui/dist/
ui/e2e/.fixture/
ui/e2e/.recordings/
ui/test-results/
ui/playwright-report/
